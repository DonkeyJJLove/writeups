      "research_corpus",
      "evidence_source",
      "publication",
      "semantic_cloud_research",
      "semantic_control_research",
      "hcl_evidence"
    ],
    "semantic_imports": [
      "architecture",
      "formalization",
      "currentness"
    ],
    "repository_dependencies": [
      "DonkeyJJLove/ai_platform"
    ],
    "architecture_artifacts": [
      {
